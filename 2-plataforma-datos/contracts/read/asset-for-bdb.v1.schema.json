{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bdb.local/contracts/read/asset-for-bdb.v1.schema.json",
  "title": "Read model asset-for-bdb.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset_id",
    "updated_at",
    "instrument_type",
    "economic_asset_class",
    "identity",
    "classification",
    "costs",
    "metrics",
    "performance_preview",
    "category",
    "pms_exposure",
    "exposure_detail",
    "holdings_summary",
    "fundamentals_summary",
    "history_available_years",
    "available_sections",
    "data_quality_summary",
    "coverage_status",
    "is_investable",
    "role",
    "quality_flags",
    "warnings"
  ],
  "properties": {
    "asset_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "instrument_type": {
      "type": "string"
    },
    "economic_asset_class": {
      "type": "string"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "isin",
        "ticker",
        "currency",
        "region"
      ],
      "properties": {
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "isin": {
          "type": [
            "string",
            "null"
          ]
        },
        "ticker": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": "string"
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "morningstar_rating"
      ],
      "properties": {
        "morningstar_rating": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "official_benchmark": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Indice de referencia oficial del fondo (classification.official_benchmark de la maestra). Opcional: ausente en payloads anteriores a 2026-10-31."
        },
        "sector": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Sector de una accion, tal como lo trae la fuente. Null en fondos y ETF, que tienen un reparto y no un sector. Opcional: ausente en payloads anteriores a 2026-11-05."
        }
      }
    },
    "costs": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "ongoing_charge": {
          "type": "number"
        },
        "management_fee": {
          "type": "number"
        },
        "transaction_costs": {
          "type": "number"
        },
        "entry_charge": {
          "type": "number"
        },
        "document_url": {
          "type": "string",
          "description": "El KID del activo, si lo tiene. Opcional: ausente en payloads anteriores a 2026-11-05."
        },
        "document_date": {
          "type": "string",
          "description": "La fecha del KID del activo, si se ha podido leer. Opcional: ausente en payloads anteriores a 2026-11-05."
        },
        "ongoing_charge_source": {
          "enum": [
            "KID",
            "PROVIDER"
          ]
        },
        "transaction_costs_source": {
          "enum": [
            "KID",
            "PROVIDER"
          ]
        },
        "entry_charge_source": {
          "enum": [
            "KID",
            "PROVIDER"
          ]
        }
      }
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "performance_preview": {
      "$ref": "#/$defs/performance_preview"
    },
    "category": {
      "type": [
        "string",
        "null"
      ]
    },
    "pms_exposure": {
      "type": "object",
      "description": "El reparto por clase del activo, en fraccion y neto, tal como lo guarda la base. Sin minimum ni maximum: en la base nueva cada clase va de -5 a 6, porque declared/exposure guarda el reparto NETO del proveedor, que suma 1, con sus cortos (una clase negativa) y su apalancamiento (una por encima de 1) (decision C-29 de Oscar, 21-11-2026; hasta ese dia, de -0,01 a 1,01 por la A-63), y la base vieja no se valida y trae de todo. Quien lo sume o lo dibuje tiene que aceptar un negativo y una clase por encima del 100 %: la suma ponderada de una cartera sigue siendo correcta, pero una barra o una porcion de aro no pueden ser negativas. Estado NOT_AVAILABLE (decision A-203 de Oscar, 21-11-2026): un fondo o ETF que no declara su reparto, o una posicion sin clase conocida, no tiene reparto, y el servidor lo marca con source = NOT_AVAILABLE. Las seis clases van entonces a cero porque este contrato las pide como numero, y ese cero NO es un reparto: quien lea el reparto mira source antes que las cifras, y con NOT_AVAILABLE no reparte ese peso en ninguna clase y lo cuenta aparte como sin reparto.",
      "additionalProperties": false,
      "required": [
        "equity",
        "fixed_income",
        "cash",
        "alternative",
        "real_asset",
        "other",
        "source"
      ],
      "properties": {
        "equity": {
          "type": "number"
        },
        "fixed_income": {
          "type": "number"
        },
        "cash": {
          "type": "number"
        },
        "alternative": {
          "type": "number"
        },
        "real_asset": {
          "type": "number"
        },
        "other": {
          "type": "number"
        },
        "source": {
          "type": "string",
          "description": "De donde sale el reparto. NOT_AVAILABLE (decision A-203, 21-11-2026) = el activo no tiene reparto declarado: las seis clases van a cero solo porque son obligatorias y no deben leerse como un reparto."
        }
      }
    },
    "exposure_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sectors",
        "equity_styles",
        "equity_regions",
        "market_caps",
        "confidence"
      ],
      "properties": {
        "sectors": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "equity_styles": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "equity_regions": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "market_caps": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "equity_style_box": {
          "type": "object",
          "description": "Las nueve celdas de la caja de estilo y tamano, en fraccion y netas de cortos, asi que una puede ser negativa. Es opcional a proposito: el activo que no la trae se lee por equity_styles y market_caps, y por eso la aplicacion lee las dos formas, instrumento a instrumento.",
          "additionalProperties": {
            "type": "number"
          }
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "fixed_income_profile": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "Perfil de renta fija del fondo (plan Mejorar cartera, fase 1). Solo FUND/ETF; ausente o null si la maestra no trae dato. Duraciones y vencimiento en anios; investment_grade_pct, high_yield_pct y yield_to_maturity en fraccion 0..1 (la maestra los guarda en %); bond_types = portfolio_exposure.bond_types en fraccion, solo con sus partes mayores que cero, y omitido si no queda ninguna. Desde el 21-11-2026 (decision C-31 de Oscar) la base nueva guarda ese mapa neto, como lo da el proveedor: una parte puede ser negativa (la liquidez de un fondo con derivados) y otra pasar de 1. Aqui las negativas no se sirven, y la equivalencia de fondos compara el tipo de emisor sin ellas, como compara la mezcla de clases (C-29).",
      "properties": {
        "effective_duration": {
          "type": "number"
        },
        "modified_duration": {
          "type": "number"
        },
        "effective_maturity": {
          "type": "number"
        },
        "yield_to_maturity": {
          "type": "number"
        },
        "investment_grade_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "high_yield_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "avg_credit_quality": {
          "type": "string"
        },
        "bond_types": {
          "$ref": "#/$defs/number_map"
        }
      }
    },
    "holdings_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "has_holdings",
        "full_holdings_loaded"
      ],
      "properties": {
        "has_holdings": {
          "type": "boolean"
        },
        "positions_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "top10_weight": {
          "type": [
            "number",
            "null"
          ]
        },
        "as_of_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "full_holdings_loaded": {
          "type": "boolean"
        },
        "securities_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Hallazgo 20 (15-11-2026): los titulos de la cartera segun el proveedor, acciones mas bonos (declared/holdings.securities_count). Es el total que se ensena: positions_count es el numero de bonos o, si no hay, el de acciones. Solo cuando se leyeron las posiciones; el resumen de la tarjeta no lo trae."
        },
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Hallazgo 20: la parte del patrimonio que cubren las posiciones de la fuente, en tanto por uno (declared/holdings.coverage). Sin ella no se sabe cuanto deja fuera una lista parcial."
        },
        "list_scope": {
          "type": "string",
          "enum": [
            "FULL",
            "TOP"
          ],
          "description": "Hallazgo 20: FULL si las posiciones servidas son la cartera entera, TOP si solo las principales (las 25 de declared/holdings.top)."
        }
      }
    },
    "fundamentals_summary": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "as_of_date": {
          "type": "string"
        },
        "fetched_at": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "coverage_status": {
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/scalar_map"
        },
        "valuation": {
          "$ref": "#/$defs/number_map"
        },
        "profitability": {
          "$ref": "#/$defs/number_map"
        },
        "growth": {
          "$ref": "#/$defs/number_map"
        },
        "per_share": {
          "$ref": "#/$defs/number_map"
        },
        "dividends": {
          "$ref": "#/$defs/scalar_map"
        },
        "fund_metrics": {
          "$ref": "#/$defs/number_map"
        },
        "holdings_summary": {
          "$ref": "#/$defs/scalar_map"
        }
      }
    },
    "history_available_years": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "available_sections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_quality_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_status",
        "has_identity",
        "has_metrics",
        "has_pms_exposure",
        "has_costs",
        "has_holdings_summary",
        "has_fundamentals",
        "has_history_years",
        "quality_flags",
        "warnings_count"
      ],
      "properties": {
        "coverage_status": {
          "type": "string"
        },
        "has_identity": {
          "type": "boolean"
        },
        "has_metrics": {
          "type": "boolean"
        },
        "has_pms_exposure": {
          "type": "boolean"
        },
        "has_costs": {
          "type": "boolean"
        },
        "has_holdings_summary": {
          "type": "boolean"
        },
        "has_fundamentals": {
          "type": "boolean"
        },
        "has_history_years": {
          "type": "boolean"
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings_count": {
          "type": "integer"
        }
      }
    },
    "coverage_status": {
      "type": "string"
    },
    "is_investable": {
      "type": "boolean"
    },
    "role": {
      "type": "string"
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "message",
          "asset_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "asset_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "metrics_window_label": {
      "type": "object",
      "additionalProperties": false,
      "description": "Con que metodo y frecuencia salen las cifras de una ventana.",
      "properties": {
        "method": {
          "type": "string"
        },
        "frequency": {
          "type": "string"
        }
      }
    },
    "metrics_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "metrics_dates_by_window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "1y": { "$ref": "#/$defs/metrics_date" },
        "3y": { "$ref": "#/$defs/metrics_date" },
        "5y": { "$ref": "#/$defs/metrics_date" },
        "10y": { "$ref": "#/$defs/metrics_date" },
        "ytd": { "$ref": "#/$defs/metrics_date" }
      }
    },
    "number_map": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "scalar_map": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "metrics_source"
      ],
      "properties": {
        "source": {
          "type": [
            "string",
            "null"
          ],
          "description": "Null cuando no hay ninguna cifra (hallazgo 18, 15-11-2026): hasta entonces decia MOCK, que es dato de prueba."
        },
        "metrics_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "as_of": {
          "$ref": "#/$defs/metrics_date",
          "description": "Hallazgo 16 (15-11-2026): a que fecha se refieren las cifras, de read/card.metrics.as_of. Solo de la base nueva y solo con cifras."
        },
        "returns_as_of": {
          "$ref": "#/$defs/metrics_date",
          "description": "Hallazgo 16: la fecha de las rentabilidades del titular cuando no es as_of (read/card.metrics.returns_as_of, decision B-74)."
        },
        "returns_as_of_by_window": {
          "$ref": "#/$defs/metrics_dates_by_window",
          "description": "Hallazgo 16: la fecha de cada rentabilidad del titular, cuando no todas son la misma (read/card.metrics.returns_as_of_by_window)."
        },
        "return_basis": {
          "type": "string",
          "enum": [
            "TOTAL_RETURN",
            "PRICE_RETURN"
          ],
          "description": "Hallazgo 16: rentabilidad total o de precio (read/card.metrics.return_basis). Una tabla que mezcla bases no compara lo mismo."
        },
        "series_class": {
          "type": "string",
          "enum": [
            "MARKET_PRICE"
          ],
          "description": "Hallazgo 16: sobre que precio se midio cuando no es el valor liquidativo (read/card.metrics.series_class). Ausente = valor liquidativo."
        },
        "distribution_policy": {
          "type": "string",
          "enum": [
            "ACCUMULATING",
            "DISTRIBUTING",
            "UNKNOWN"
          ],
          "description": "Hallazgo 16: la politica de reparto (read/card.metrics.distribution_policy)."
        },
        "windows_out_of_range": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Hallazgo 16: las cifras nuestras apartadas por salirse de rango, por su ruta (read/card.metrics.windows_out_of_range)."
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "description": "Hallazgo 16: las fechas del bloque del proveedor (read/card.metrics.provider), cuando alguna ventana es suya (metrics_method PROPIA_Y_PROVEEDOR). Solo las fechas: sus cifras ya van en las ventanas.",
          "properties": {
            "as_of": {
              "$ref": "#/$defs/metrics_date"
            },
            "returns_as_of": {
              "$ref": "#/$defs/metrics_date"
            },
            "returns_as_of_by_window": {
              "$ref": "#/$defs/metrics_dates_by_window"
            }
          }
        },
        "volatility_1y": {
          "type": "number"
        },
        "volatility_3y": {
          "type": "number"
        },
        "volatility_5y": {
          "type": "number"
        },
        "sharpe_1y": {
          "type": "number"
        },
        "sharpe_3y": {
          "type": "number"
        },
        "sharpe_5y": {
          "type": "number"
        },
        "annualized_return_1y": {
          "type": "number"
        },
        "annualized_return_3y": {
          "type": "number"
        },
        "annualized_return_5y": {
          "type": "number"
        },
        "annualized_return_10y": {
          "type": "number"
        },
        "ytd_return": {
          "type": "number"
        },
        "max_drawdown_hist": {
          "type": "number"
        },
        "max_drawdown_hist_date": {
          "type": "string"
        },
        "max_drawdown_5y": {
          "type": "number"
        },
        "risk_score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "risk_score_source": {
          "type": "string",
          "enum": [
            "SRRI",
            "SRI_KID",
            "VOL_BUCKET"
          ]
        },
        "metrics_method": {
          "type": "string",
          "enum": [
            "GEOMETRIC_CAGR",
            "TRAILING_PROVIDER",
            "EXTRACTOR_MONTHLY_V1",
            "EXTRACTOR_DAILY_V1",
            "EXTRACTOR_MONTHLY_V2",
            "EXTRACTOR_DAILY_V2",
            "EXTRACTOR_MONTHLY_V3",
            "EXTRACTOR_DAILY_V3",
            "EXTRACTOR_MONTHLY_V4",
            "EXTRACTOR_DAILY_V4",
            "PROPIA_Y_PROVEEDOR"
          ],
          "description": "metrics.v1.2: con que metodologia se calculo. Ausente = desconocida, no comparable. Los EXTRACTOR_* son los de la base nueva, que ya viajaban por aqui sin estar en esta lista. PROPIA_Y_PROVEEDOR entra el 05-11-2026 con la decision 110 de Oscar: un activo con cifras nuestras y, en las ventanas a las que nuestra serie no llega, las del proveedor; sin el, el informe diria que no consta de donde salen. EXTRACTOR_MONTHLY_V3 y EXTRACTOR_DAILY_V3 entran el 16-11-2026 con la version 3 del metodo (decisiones A-158 y A-166): el tipo sin riesgo mensual capitaliza con su base de dias, la volatilidad diaria se anualiza con las observaciones que hay, y un dato suelto que salta y vuelve no corta la serie. EXTRACTOR_MONTHLY_V4 y EXTRACTOR_DAILY_V4 entran el 17-11-2026 con la version 4 (MET-6 y MET-7 de la auditoria integral): un cierre de mes tiene que ser del final del mes, el anio natural aplica la regla del hueco, y las relativas cierran en el mismo mes que el riesgo o no se dan."
        },
        "metrics_frequency": {
          "type": "string",
          "enum": [
            "DAILY",
            "WEEKLY",
            "MONTHLY",
            "PROVIDER"
          ],
          "description": "metrics.v1.2: frecuencia de las observaciones con las que se midio la volatilidad."
        },
        "metrics_by_window": {
          "type": "object",
          "additionalProperties": false,
          "description": "Solo con metrics_method PROPIA_Y_PROVEEDOR (decision 110 de Oscar, 05-11-2026): el metodo y la frecuencia de cada ventana con cifras. Un activo mezclado no tiene una frecuencia comun, y sin esto un solo fondo con la cifra a 10 anios del proveedor dejaba sin volatilidad estimada a toda su cartera, aunque sus cifras a 3 anios fueran nuestras, como las de las demas. Quien lee una ventana lee el rotulo de esa ventana.",
          "properties": {
            "1y": { "$ref": "#/$defs/metrics_window_label" },
            "3y": { "$ref": "#/$defs/metrics_window_label" },
            "5y": { "$ref": "#/$defs/metrics_window_label" },
            "10y": { "$ref": "#/$defs/metrics_window_label" }
          }
        },
        "volatility_10y": {
          "type": "number"
        },
        "sharpe_10y": {
          "type": "number"
        }
      }
    },
    "performance_preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "source",
        "data_quality"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "ytd_return": {
          "type": [
            "number",
            "null"
          ]
        },
        "annualized_return_1y": {
          "type": [
            "number",
            "null"
          ]
        },
        "annualized_return_3y": {
          "type": [
            "number",
            "null"
          ]
        },
        "annualized_return_5y": {
          "type": [
            "number",
            "null"
          ]
        },
        "annualized_return_10y": {
          "type": [
            "number",
            "null"
          ]
        },
        "volatility_1y": {
          "type": [
            "number",
            "null"
          ]
        },
        "volatility_3y": {
          "type": [
            "number",
            "null"
          ]
        },
        "volatility_5y": {
          "type": [
            "number",
            "null"
          ]
        },
        "sharpe_3y": {
          "type": [
            "number",
            "null"
          ]
        },
        "sharpe_5y": {
