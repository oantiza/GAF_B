{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gestor-activos.local/contracts/base-nueva/reference-rate.v2.schema.json",
  "title": "reference_rates/{rate_id} — v2",
  "description": "Un anio de un tipo de referencia publicado, hoy la ESTR del BCE (EST/B.EU000A2X2A25.WT). Es el tipo libre de riesgo del Sharpe de cartera. Se guarda para que la cifra se pueda reproducir y para que el calculo no dependa de que el BCE responda en ese momento: una ESTR publicada no cambia. Solo la leen las Cloud Functions.",
  "x-collection": "reference_rates/{rate_id}",
  "x-layer": "declared",
  "x-owner": "platform",
  "type": "object",
  "additionalProperties": false,
  "required": ["rate", "year", "series_key", "source", "first_date", "last_date", "observations", "points"],
  "properties": {
    "rate": {
      "type": "string",
      "enum": ["ESTR"],
      "x-unit": "code",
      "x-layer": "metadata",
      "x-owner": "platform"
    },
    "year": {
      "type": "string",
      "pattern": "^[0-9]{4}$",
      "x-unit": "code",
      "x-layer": "metadata",
      "x-owner": "platform"
    },
    "series_key": {
      "type": "string",
      "minLength": 1,
      "x-unit": "code",
      "x-layer": "metadata",
      "x-owner": "platform"
    },
    "source": {
      "type": "string",
      "const": "ECB",
      "x-unit": "code",
      "x-layer": "metadata",
      "x-owner": "platform"
    },
    "first_date": {
      "type": "string",
      "x-unit": "date",
      "x-layer": "metadata",
      "x-owner": "platform"
    },
    "last_date": {
      "type": "string",
      "x-unit": "date",
      "x-layer": "metadata",
      "x-owner": "platform"
    },
    "observations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 366,
      "x-unit": "count",
      "x-layer": "metadata",
      "x-owner": "platform"
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 366,
      "x-layer": "declared",
      "x-owner": "platform",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "value"],
        "x-layer": "declared",
        "x-owner": "platform",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "x-unit": "date",
            "x-layer": "declared",
            "x-owner": "platform"
          },
          "value": {
            "type": "number",
            "minimum": -0.2,
            "maximum": 0.5,
            "description": "En FRACCION, como todo en esta base: 0,0193 es un 1,93 %. El BCE lo publica en por ciento. Puede ser negativo: la ESTR lo fue hasta 2022.",
            "x-unit": "fraction",
            "x-layer": "declared",
            "x-owner": "platform"
          }
        }
      }
    }
  }
}
