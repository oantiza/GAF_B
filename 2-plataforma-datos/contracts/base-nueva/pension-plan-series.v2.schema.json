{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gestor-activos.local/contracts/base-nueva/pension-plan-series.v2.schema.json",
  "title": "pension_plans/{plan_id}/series/monthly — v2",
  "description": "La evolucion del valor de la participacion de un plan de pensiones o una EPSV, para el grafico de su ficha (decision D-11, Oscar, 13-11-2026). Es el ULTIMO valor de cada mes de la serie diaria que da el proveedor, mas el ultimo punto aunque el mes no haya acabado. No es una media ni un calculo: es elegir que puntos se guardan, y lo hace el extractor.\n\nMensual y no diaria por dos razones. Una ficha de comparacion no necesita mas para ensenar como ha ido un plan en veinte anos; y con estos puntos no se calcula nada aqui —ni volatilidad, ni rentabilidades, ni metricas—, que es justo lo que este catalogo no hace. Las cifras de la ficha son las del proveedor; esto es solo el dibujo.\n\nVa en un documento aparte de `pension_plans/{plan_id}` porque es lo que pesa: listar los 220 planes no debe arrastrar 220 series. Con un punto por mes, un plan de 1988 no llega a 470 puntos, por debajo del tope de 500 de toda la base.",
  "x-collection": "pension_plans/{plan_id}/series/monthly",
  "x-layer": "declared",
  "x-owner": "platform",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_id", "schema_version", "updated_at", "source", "price_class", "frequency", "first_date", "last_date", "observations", "points"],
  "properties": {
    "plan_id": {
      "type": "string",
      "pattern": "^[A-Z0-9]{10}$",
      "x-unit": "code",
      "x-layer": "metadata",
      "x-owner": "platform"
    },
    "schema_version": {
      "type": "string",
      "const": "base-nueva.pension-plan-series.v2",
      "x-unit": "code",
      "x-layer": "metadata",
      "x-owner": "platform"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1,
      "x-unit": "date",
      "x-layer": "metadata",
      "x-owner": "platform"
    },
    "source": {
      "type": "string",
      "enum": ["MORNINGSTAR"],
      "x-unit": "code",
      "x-layer": "metadata",
      "x-owner": "platform"
    },
    "price_class": {
      "type": "string",
      "enum": ["NAV"],
      "description": "Valor de la participacion. Un plan no cotiza: no hay otro precio.",
      "x-unit": "code",
      "x-layer": "declared",
      "x-owner": "platform"
    },
    "frequency": {
      "type": "string",
      "enum": ["MONTH_END"],
      "description": "El ultimo valor publicado de cada mes. El ultimo punto puede ser de un mes sin acabar.",
      "x-unit": "code",
      "x-layer": "metadata",
      "x-owner": "platform"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "x-unit": "code",
      "x-layer": "declared",
      "x-owner": "platform",
      "x-absence": "NOT_PROVIDED"
    },
    "first_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "x-unit": "date",
      "x-layer": "metadata",
      "x-owner": "platform"
    },
    "last_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "x-unit": "date",
      "x-layer": "metadata",
      "x-owner": "platform"
    },
    "observations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "x-unit": "count",
      "x-layer": "metadata",
      "x-owner": "platform"
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "description": "En orden ascendente y sin fechas repetidas.",
      "x-layer": "declared",
      "x-owner": "platform",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "value"],
        "x-layer": "declared",
        "x-owner": "platform",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "x-unit": "date",
            "x-layer": "declared",
            "x-owner": "platform"
          },
          "value": {
            "type": "number",
            "exclusiveMinimum": 0,
            "x-unit": "currency_amount",
            "x-layer": "declared",
            "x-owner": "platform"
          }
        }
      }
    }
  }
}
