{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bdb.local/contracts/master/price-series.v1.2.schema.json",
  "title": "Master price series year bucket - v1.2",
  "description": "Contrato persistido para series NAV, niveles de indice y precios OHLCV, con conversion opcional a EUR. value es siempre el valor canonico consumible; OHLCV y campos source conservan trazabilidad.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "asset_type",
    "series_type",
    "source",
    "source_price_id",
    "document_id",
    "currency",
    "interval",
    "year",
    "points",
    "first_date",
    "last_date",
    "observations_count",
    "history_quality_status",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "asset-price-series.v1.2" },
    "asset_id": { "type": "string", "minLength": 1 },
    "asset_type": { "type": "string", "enum": ["FUND", "ETF", "STOCK", "EQUITY", "INDEX", "OTHER"] },
    "series_type": { "type": "string", "enum": ["NAV", "ADJUSTED_CLOSE", "INDEX_LEVEL"] },
    "source": { "type": "string", "enum": ["EODHD", "YAHOO", "MORNINGSTAR", "CNMV", "OTHER"] },
    "source_price_id": { "type": "string" },
    "document_id": { "type": "string" },
    "source_listing_id": { "type": ["string", "null"] },
    "currency": { "type": "string" },
    "source_currency": { "type": ["string", "null"] },
    "native_currency": { "type": ["string", "null"] },
    "fx_pair": { "type": ["string", "null"] },
    "fx_policy": { "type": ["string", "null"] },
    "fx_source": { "type": ["string", "null"] },
    "fx_applied": { "type": ["boolean", "null"] },
    "minor_scale": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "instrument_type": { "type": ["string", "null"] },
    "metadata": { "type": ["object", "null"], "additionalProperties": true },
    "refresh": { "type": "boolean" },
    "interval": {
      "type": "string",
      "enum": ["1d", "1mo"],
      "description": "Frecuencia observada: diaria o cierre mensual. No se interpolan puntos para aparentar una frecuencia mayor."
    },
    "year": { "type": "integer", "minimum": 1900, "maximum": 2200 },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "value"],
        "properties": {
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "value": { "type": "number", "exclusiveMinimum": 0 },
          "open": { "type": ["number", "null"] },
          "high": { "type": ["number", "null"] },
          "low": { "type": ["number", "null"] },
          "close": { "type": ["number", "null"] },
          "adjusted_close": { "type": ["number", "null"] },
          "volume": { "type": ["number", "null"], "minimum": 0 },
          "source_currency": { "type": ["string", "null"] },
          "native_currency": { "type": ["string", "null"] },
          "source_value": { "type": ["number", "null"] },
          "source_open": { "type": ["number", "null"] },
          "source_high": { "type": ["number", "null"] },
          "source_low": { "type": ["number", "null"] },
          "source_close": { "type": ["number", "null"] },
          "source_adjusted_close": { "type": ["number", "null"] },
          "fx_pair": { "type": ["string", "null"] },
          "fx_rate": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "fx": {
            "type": ["number", "object", "null"],
            "additionalProperties": true
          }
        }
      }
    },
    "first_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "last_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "observations_count": { "type": "integer", "minimum": 0 },
    "history_quality_status": { "type": "string", "enum": ["COMPLETE", "PARTIAL", "BLOCKED"] },
    "updated_at": { "type": "string" }
  }
}
