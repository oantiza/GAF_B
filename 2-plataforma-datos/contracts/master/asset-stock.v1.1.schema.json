{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bdb.local/contracts/master/asset-stock.v1.1.schema.json",
  "title": "Master asset STOCK (assets/{asset_id}, asset_type='STOCK') — v1.1",
  "description": "Superconjunto compatible de asset-stock.v1. Anade x-owner por bloque y provenance (canonico de acciones). Con source FondosDB los bloques 'plataforma' los reescribe el republish; con source EODHD el documento entero es de la app (ingest_asset lo crea; nadie lo republica). Los bloqueos de seleccion (is_investable, notas de revision) NO viven aqui: son de la app (asset_selection_controls).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset_id",
    "asset_type",
    "identity",
    "identifiers",
    "classification",
    "product",
    "listings",
    "quality",
    "source_metadata"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$",
      "description": "ISIN.",
      "x-owner": "metadatos"
    },
    "asset_type": {
      "type": "string",
      "const": "STOCK",
      "x-owner": "plataforma"
    },
    "schema_version": {
      "type": "string",
      "description": "ADITIVO opcional.",
      "x-owner": "metadatos"
    },
    "updated_at": {
      "type": "string",
      "description": "ADITIVO opcional.",
      "x-owner": "metadatos"
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "description": "Alias de consulta conservado por compatibilidad.",
      "x-owner": "legado"
    },
    "economic_asset_class": {
      "type": [
        "string",
        "null"
      ],
      "description": "Clasificacion economica de consulta, separada de asset_type.",
      "x-owner": "legado"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "x-owner": "plataforma"
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isin"
      ],
      "properties": {
        "isin": {
          "type": "string"
        },
        "ticker": {
          "type": [
            "string",
            "null"
          ]
        },
        "eodhd_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "x-owner": "plataforma"
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "fondosdb_asset_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "fondosdb_asset_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "asset_subtype": {
          "type": [
            "string",
            "null"
          ]
        },
        "region_primary": {
          "type": [
            "string",
            "null"
          ]
        },
        "strategy_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "x-owner": "plataforma"
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_type",
        "has_listing"
      ],
      "properties": {
        "product_type": {
          "type": "string"
        },
        "commercial_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "vehicle_complexity": {
          "type": [
            "string",
            "null"
          ]
        },
        "has_listing": {
          "type": "boolean"
        }
      },
      "x-owner": "plataforma"
    },
    "listings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "listing_id",
          "is_primary",
          "data_sources"
        ],
        "properties": {
          "listing_id": {
            "type": "string"
          },
          "ticker": {
            "type": [
              "string",
              "null"
            ]
          },
          "exchange": {
            "type": [
              "string",
              "null"
            ]
          },
          "currency": {
            "type": [
              "string",
              "null"
            ]
          },
          "eodhd_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_listing_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_primary": {
            "type": "boolean"
          },
          "data_sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "x-owner": "plataforma"
    },
    "performance": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "x-owner": "plataforma",
      "x-owner-exceptions": {
        "valuation": "app"
      }
    },
    "risk": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "x-owner": "plataforma"
    },
    "fundamentals": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "x-owner": "plataforma"
    },
    "portfolio_exposure": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "x-owner": "plataforma"
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warnings",
        "validation_errors",
        "review_flags"
      ],
      "properties": {
        "fondosdb_bucket": {
          "type": [
            "string",
            "null"
          ]
        },
        "fondosdb_ok": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "PROVISIONAL_ADMIN"
          ]
        },
        "history_trace": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      },
      "x-owner": "plataforma"
    },
    "source_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "FondosDB",
            "EODHD"
          ]
        },
        "source_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "generated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "report_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "universal_export_present": {
          "type": "boolean"
        },
        "source_history": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_listing_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "firestore_import_block": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "x-owner": "plataforma"
    },
    "provenance": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "x-owner": "plataforma",
      "description": "NUEVO v1.2. Procedencia por campo del canonico (provenance.fields: ruta canonica -> 'fuente:endpoint'). Version compacta: endpoints, plan, sources y dependency se quedan en el canonico.",
      "required": [
        "fields"
      ],
      "properties": {
        "version": {
          "type": "integer"
        },
        "acquired_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "x-owner-by-source": {
    "FondosDB": "por bloque (x-owner)",
    "EODHD": "app (documento entero)"
  }
}
