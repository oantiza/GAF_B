{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bdb.local/contracts/master/asset-stock.v1.schema.json",
  "title": "Master asset STOCK (assets/{asset_id}, asset_type='STOCK') — v1",
  "description": "Documento raiz de una ACCION en la maestra, tal como lo produce la tuberia stock (src/ingestion/fondosdbStockAssets.ts -> buildStockRow). Es un contrato SEPARADO del de fondos (master/asset.v1): las acciones traen identifiers.ticker/eodhd_code/aliases, listings poblado con source_listing_id, fundamentals, quality.history_trace y source_metadata con campos de histórico; y NO traen costs ni fixed_income_profile. Crear este archivo cierra el hueco F1 (que solo cubrio fondos) sin tocar master/asset.v1 (riesgo cero para los 573 fondos). schema_version/updated_at son aditivos opcionales.",
  "type": "object",
  "additionalProperties": false,
  "required": ["asset_id", "asset_type", "identity", "identifiers", "classification", "product", "listings", "quality", "source_metadata"],
  "properties": {
    "asset_id": { "type": "string", "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$", "description": "ISIN." },
    "asset_type": { "type": "string", "const": "STOCK" },
    "schema_version": { "type": "string", "description": "ADITIVO opcional." },
    "updated_at": { "type": "string", "description": "ADITIVO opcional." },
    "currency": { "type": ["string", "null"], "description": "Alias de consulta conservado por compatibilidad." },
    "economic_asset_class": { "type": ["string", "null"], "description": "Clasificacion economica de consulta, separada de asset_type." },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "currency": { "type": ["string", "null"] }
      }
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isin"],
      "properties": {
        "isin": { "type": "string" },
        "ticker": { "type": ["string", "null"] },
        "eodhd_code": { "type": ["string", "null"] },
        "aliases": { "type": "array", "items": { "type": "string" } }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_class": { "type": ["string", "null"] },
        "fondosdb_asset_class": { "type": ["string", "null"] },
        "fondosdb_asset_type": { "type": ["string", "null"] },
        "asset_subtype": { "type": ["string", "null"] },
        "region_primary": { "type": ["string", "null"] },
        "strategy_tags": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": ["number", "null"] }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_type", "has_listing"],
      "properties": {
        "product_type": { "type": "string" },
        "commercial_type": { "type": ["string", "null"] },
        "vehicle_complexity": { "type": ["string", "null"] },
        "has_listing": { "type": "boolean" }
      }
    },
    "listings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["listing_id", "is_primary", "data_sources"],
        "properties": {
          "listing_id": { "type": "string" },
          "ticker": { "type": ["string", "null"] },
          "exchange": { "type": ["string", "null"] },
          "currency": { "type": ["string", "null"] },
          "eodhd_code": { "type": ["string", "null"] },
          "source_listing_id": { "type": ["string", "null"] },
          "is_primary": { "type": "boolean" },
          "data_sources": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "performance": { "type": ["object", "null"], "additionalProperties": true },
    "risk": { "type": ["object", "null"], "additionalProperties": true },
    "fundamentals": { "type": ["object", "null"], "additionalProperties": true },
    "portfolio_exposure": { "type": ["object", "null"], "additionalProperties": true },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warnings", "validation_errors", "review_flags"],
      "properties": {
        "fondosdb_bucket": { "type": ["string", "null"] },
        "fondosdb_ok": { "type": ["boolean", "null"] },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "validation_errors": { "type": "array", "items": { "type": "string" } },
        "review_flags": { "type": "array" },
        "status": { "type": "string", "enum": ["PROVISIONAL_ADMIN"] },
        "history_trace": { "type": ["object", "null"], "additionalProperties": true }
      }
    },
    "source_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "enum": ["FondosDB", "EODHD"] },
        "source_file": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"] },
        "report_date": { "type": ["string", "null"] },
        "universal_export_present": { "type": "boolean" },
        "source_history": { "type": ["string", "null"] },
        "source_listing_id": { "type": ["string", "null"] },
        "firestore_import_block": { "type": ["string", "null"] }
      }
    }
  }
}
