{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bdb.local/contracts/master/asset-market.v1.schema.json",
  "title": "Master EODHD market asset - v1",
  "description": "Raiz provisional administrada para ETF e indices resueltos directamente por EODHD.",
  "type": "object",
  "additionalProperties": false,
  "required": ["asset_id", "asset_type", "schema_version", "identity", "identifiers", "classification", "product", "listings", "quality", "source_metadata"],
  "properties": {
    "asset_id": { "type": "string", "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$" },
    "asset_type": { "type": "string", "enum": ["ETF", "INDEX"] },
    "schema_version": { "type": "string", "const": "master.asset-eodhd-market.v1" },
    "updated_at": { "type": "string" },
    "currency": { "type": ["string", "null"] },
    "economic_asset_class": { "type": ["string", "null"] },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "currency": { "type": ["string", "null"] }
      }
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isin"],
      "properties": {
        "isin": { "type": "string" },
        "ticker": { "type": ["string", "null"] },
        "eodhd_code": { "type": ["string", "null"] },
        "aliases": { "type": "array", "items": { "type": "string" } }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_class": { "type": ["string", "null"] },
        "fondosdb_asset_class": { "type": ["string", "null"] },
        "fondosdb_asset_type": { "type": ["string", "null"] },
        "asset_subtype": { "type": ["string", "null"] },
        "region_primary": { "type": ["string", "null"] },
        "strategy_tags": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": ["number", "null"] }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_type", "has_listing"],
      "properties": {
        "product_type": { "type": "string" },
        "commercial_type": { "type": ["string", "null"] },
        "vehicle_complexity": { "type": ["string", "null"] },
        "has_listing": { "type": "boolean", "const": true }
      }
    },
    "listings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["listing_id", "is_primary", "data_sources"],
        "properties": {
          "listing_id": { "type": "string" },
          "ticker": { "type": ["string", "null"] },
          "exchange": { "type": ["string", "null"] },
          "currency": { "type": ["string", "null"] },
          "eodhd_code": { "type": ["string", "null"] },
          "source_listing_id": { "type": ["string", "null"] },
          "is_primary": { "type": "boolean" },
          "data_sources": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "costs": { "type": ["object", "null"], "additionalProperties": true },
    "performance": { "type": ["object", "null"], "additionalProperties": true },
    "fundamentals": { "type": ["object", "null"], "additionalProperties": true },
    "risk": { "type": ["object", "null"], "additionalProperties": true },
    "portfolio_exposure": { "type": ["object", "null"], "additionalProperties": true },
    "holdings_summary": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["has_holdings", "full_holdings_loaded"],
      "properties": {
        "has_holdings": { "type": "boolean" },
        "full_holdings_loaded": { "type": "boolean" },
        "positions_count": { "type": ["integer", "null"], "minimum": 0 },
        "top10_weight": { "type": ["number", "null"] },
        "as_of_date": { "type": ["string", "null"] }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "warnings", "validation_errors", "review_flags"],
      "properties": {
        "fondosdb_bucket": { "type": ["string", "null"] },
        "fondosdb_ok": { "type": ["boolean", "null"] },
        "status": { "type": "string", "const": "PROVISIONAL_ADMIN" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "validation_errors": { "type": "array", "items": { "type": "string" } },
        "review_flags": { "type": "array", "items": { "type": "string" } },
        "history_trace": { "type": ["object", "null"], "additionalProperties": true }
      }
    },
    "source_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "const": "EODHD" },
        "source_file": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"] },
        "report_date": { "type": ["string", "null"] },
        "universal_export_present": { "type": "boolean" },
        "source_history": { "type": ["string", "null"] },
        "source_listing_id": { "type": ["string", "null"] },
        "firestore_import_block": { "type": ["string", "null"] }
      }
    }
  }
}
