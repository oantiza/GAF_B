{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bdb.local/contracts/master/holdings.v1.2.schema.json",
  "title": "Master holdings - v1.2",
  "description": "v1.1 aditivo: `provenance` opcional en holdings/latest y en el manifest CHUNKED (fuente, fecha de obtencion y cobertura de la cartera, copiadas del canonico del extractor). Todo documento v1.1 valida en v1.2.",
  "x-owner": "plataforma",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage_mode", "holdings_count", "as_of_date", "holdings"],
      "properties": {
        "storage_mode": { "type": "string", "const": "SINGLE_DOCUMENT" },
        "holdings_count": { "type": ["number", "null"] },
        "top10_weight": { "type": ["number", "null"] },
        "as_of_date": { "type": ["string", "null"] },
        "holdings": { "type": ["array", "null"], "items": { "type": "object", "additionalProperties": true } },
        "provenance": { "$ref": "#/$defs/provenance" },
        "schema_version": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage_mode", "chunk_count", "holdings_count", "top10_weight", "as_of_date"],
      "properties": {
        "storage_mode": { "type": "string", "const": "CHUNKED" },
        "chunk_count": { "type": "integer", "minimum": 1 },
        "holdings_count": { "type": ["number", "null"] },
        "top10_weight": { "type": ["number", "null"] },
        "as_of_date": { "type": ["string", "null"] },
        "provenance": { "$ref": "#/$defs/provenance" },
        "schema_version": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage_mode", "chunk_index", "holdings_count", "holdings"],
      "properties": {
        "storage_mode": { "type": "string", "const": "CHUNK" },
        "chunk_index": { "type": "integer", "minimum": 0 },
        "holdings_count": { "type": "integer", "minimum": 0 },
        "holdings": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "schema_version": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    }
  ],
  "$defs": {
    "provenance": {
      "description": "De donde sale la cartera. Lo escribe la plataforma a partir de `procedencia` en export/posiciones.ndjson.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["source", "coverage"],
      "properties": {
        "source": { "type": "string", "minLength": 1, "description": "Adaptador del extractor: morningstar_lt, justetf, cnmv..." },
        "endpoint": { "type": ["string", "null"], "description": "Endpoint del adaptador: sal_position, ETFsnapshot, FONDCART..." },
        "source_id": { "type": ["string", "null"], "description": "Identificador en la fuente (SecId de Morningstar, n.o de registro...)." },
        "document_url": { "type": ["string", "null"], "description": "URL publica del documento cuando la fuente es un PDF; nunca la de una API con clave." },
        "retrieved_at": { "type": ["string", "null"], "description": "Cuando se obtuvo la respuesta (ISO 8601)." },
        "response_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "as_of_date_basis": { "enum": ["holdings_detail", "snapshot", "document", "unknown"], "description": "De donde sale as_of_date." },
        "coverage": { "enum": ["COMPLETE", "TOP_N", "PARTIAL", "UNKNOWN"], "description": "COMPLETE: todas las posiciones que declara la fuente; TOP_N: solo las principales (p. ej. supresion de Morningstar); PARTIAL: el resto." },
        "declared_holdings_count": { "type": ["integer", "null"], "minimum": 0 },
        "provider_suppression": { "type": ["boolean", "null"] },
        "extractor_run_id": { "type": ["string", "null"] }
      }
    }
  }
}
