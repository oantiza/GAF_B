{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bdb.local/contracts/master/price-series.v1.schema.json",
  "title": "Master price series year bucket (assets/{asset_id}/price_series/{source_price_id}) — v1",
  "description": "Serie de precios diaria, BUCKETIZADA POR ANO (un documento por ano). Subcoleccion price_series. schema_version='asset-price-series.v1' ya presente en produccion. 'value' en la divisa 'currency'. El writer de holdings tiene PROHIBIDO tocar esta subcoleccion (firestorePathContract: FORBIDDEN_ASSET_SUBCOLLECTION_PATTERN).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "asset_id", "asset_type", "series_type", "source", "source_price_id", "document_id", "currency", "interval", "year", "points", "first_date", "last_date", "observations_count", "history_quality_status", "updated_at"],
  "properties": {
    "schema_version": { "type": "string", "const": "asset-price-series.v1" },
    "asset_id": { "type": "string", "minLength": 1, "description": "Normalmente ISIN; los INDEX pueden usar otro codigo." },
    "asset_type": { "type": "string", "enum": ["FUND", "ETF", "STOCK", "INDEX"] },
    "series_type": { "type": "string", "enum": ["NAV", "ADJUSTED_CLOSE", "INDEX_LEVEL"] },
    "source": { "type": "string", "enum": ["EODHD", "YAHOO", "MORNINGSTAR", "CNMV", "OTHER"] },
    "source_price_id": { "type": "string" },
    "document_id": { "type": "string" },
    "source_listing_id": { "type": ["string", "null"] },
    "currency": { "type": "string" },
    "interval": { "type": "string", "const": "1d" },
    "year": { "type": "integer" },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "value"],
        "properties": {
          "date": { "type": "string", "description": "YYYY-MM-DD." },
          "value": { "type": "number" }
        }
      }
    },
    "first_date": { "type": "string" },
    "last_date": { "type": "string" },
    "observations_count": { "type": "integer" },
    "history_quality_status": { "type": "string", "enum": ["COMPLETE", "PARTIAL", "BLOCKED"] },
    "updated_at": { "type": "string" }
  }
}
