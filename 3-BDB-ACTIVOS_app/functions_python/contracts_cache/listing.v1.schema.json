{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bdb.local/contracts/master/listing.v1.schema.json",
  "title": "Master listing (assets/{asset_id}/listings/{listing_id}) — v1",
  "description": "Cotizacion/listing de un activo (subcoleccion listings). La misma forma aparece embebida en assets/{asset_id}.listings[]. Subcoleccion vetada al writer de holdings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["listing_id", "ticker", "exchange", "is_primary", "data_sources"],
  "properties": {
    "listing_id": { "type": "string" },
    "ticker": { "type": "string" },
    "exchange": { "type": "string" },
    "currency": { "type": ["string", "null"] },
    "eodhd_code": { "type": ["string", "null"] },
    "figi": { "type": ["string", "null"] },
    "is_primary": { "type": "boolean" },
    "data_sources": { "type": "array", "items": { "type": "string" } }
  }
}
