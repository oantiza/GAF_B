{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bdb.local/contracts/master/metrics.v1.schema.json",
  "title": "Master metrics latest (assets/{asset_id}/metrics/latest) — v1",
  "description": "Metricas de precio mas recientes (documento 'latest'), calculadas desde price_series. Subcoleccion metrics (vetada al writer de holdings). max_drawdown como fraccion negativa (p.ej. -0.42). daily_returns es opcional (el writer puede omitirlo). max_drawdown_hist es ADITIVO opcional (maxima caida historica; ver metodologia 5a vs historica), aun pendiente de produccion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["asset_id", "listing_id", "ticker", "cumulative_return", "annualized_volatility", "max_drawdown", "sharpe_ratio", "cagr", "observations_count", "first_date", "last_date", "missing_close_count", "history_quality_status", "updated_at"],
  "properties": {
    "asset_id": { "type": "string", "minLength": 1 },
    "listing_id": { "type": "string" },
    "ticker": { "type": "string" },
    "daily_returns": {
      "type": ["array", "null"],
      "description": "Opcional; el writer puede omitirlo para ahorrar espacio.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "return"],
        "properties": {
          "date": { "type": "string" },
          "return": { "type": "number" }
        }
      }
    },
    "cumulative_return": { "type": ["number", "null"] },
    "annualized_volatility": { "type": ["number", "null"] },
    "max_drawdown": { "type": ["number", "null"], "description": "Ventana titular (5a). Fraccion negativa." },
    "max_drawdown_hist": { "type": ["number", "null"], "description": "ADITIVO. Maxima caida historica completa. Pendiente en produccion." },
    "sharpe_ratio": { "type": ["number", "null"] },
    "cagr": { "type": ["number", "null"] },
    "observations_count": { "type": "integer" },
    "first_date": { "type": ["string", "null"] },
    "last_date": { "type": ["string", "null"] },
    "missing_close_count": { "type": "integer" },
    "history_quality_status": { "type": "string", "enum": ["OK", "REVIEW", "BLOCKED"] },
    "updated_at": { "type": "string" }
  }
}
