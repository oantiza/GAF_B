{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bdb.local/contracts/master/asset.v1.1.schema.json",
  "title": "Master asset (assets/{asset_id}) — v1.1",
  "description": "Documento raiz en la maestra Firestore, tal como existe en produccion (los 404). SALIDA de la ingesta y ENTRADA de la app. v1 describe lo que YA hay; un cambio estructural incompatible => nueva version. schema_version y updated_at son ADITIVOS opcionales (el cargador nuevo puede estamparlos sin romper los 404). additionalProperties=false para detectar deriva; los bloques passthrough quedan abiertos porque el mapper los copia tal cual. v1.1 aditivo: classification.morningstar_rating (1..5) e identificadores/listings de ETF cuando FondosDB trae cotizacion. Un ETF puede ser listable aunque listings este vacio si el ticker/mercado no se resolvio aun.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset_id",
    "asset_type",
    "identity",
    "product",
    "quality",
    "source_metadata"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$",
      "description": "ISIN."
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "FUND",
        "ETF",
        "STOCK",
        "INDEX",
        "OTHER",
        "UNKNOWN"
      ]
    },
    "schema_version": {
      "type": "string",
      "description": "ADITIVO. Para esta version: 'master.asset.v1.1'."
    },
    "updated_at": {
      "type": "string",
      "description": "ADITIVO. ISO timestamp de la ultima escritura."
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "isin": {
          "type": [
            "string",
            "null"
          ]
        },
        "ticker": {
          "type": [
            "string",
            "null"
          ]
        },
        "eodhd_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "listings": {
      "type": "array",
      "description": "Listings embebidos resueltos. Para ETF listable sin listing resuelto se permite [].",
      "items": {
        "$ref": "#/$defs/listing"
      }
    },
    "classification": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "asset_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "fondosdb_asset_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "fondosdb_asset_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "asset_subtype": {
          "type": [
            "string",
            "null"
          ]
        },
        "region_primary": {
          "type": [
            "string",
            "null"
          ]
        },
        "strategy_tags": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ]
        },
        "morningstar_rating": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_type",
        "has_listing"
      ],
      "properties": {
        "product_type": {
          "type": "string"
        },
        "commercial_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "vehicle_complexity": {
          "type": [
            "string",
            "null"
          ]
        },
        "fund_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "has_listing": {
          "type": "boolean"
        }
      }
    },
    "costs": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "management_fee_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "ter_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "mifid_ongoing_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "retrocession": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "performance": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Passthrough del export universal (rentabilidad/valoracion/distribuciones)."
    },
    "fundamentals": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "description": "Solo ETF: resumen fundamental compacto y versionado. Los fondos no usan EODHD para fundamentales."
    },
    "risk": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "sustainability": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "portfolio_exposure": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Passthrough de portfolio_exposure_v2 (fracciones 0-1)."
    },
    "fixed_income_profile": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "holdings_summary": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "has_holdings",
        "full_holdings_loaded"
      ],
      "properties": {
        "has_holdings": {
          "type": "boolean"
        },
        "positions_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "top10_weight": {
          "type": [
            "number",
            "null"
          ]
        },
        "as_of_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "full_holdings_loaded": {
          "type": "boolean"
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "warnings",
        "validation_errors",
        "review_flags"
      ],
      "properties": {
        "fondosdb_bucket": {
          "type": [
            "string",
            "null"
          ]
        },
        "fondosdb_ok": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "ACCEPTED",
            "REVIEW",
            "REJECTED"
          ]
        }
      }
    },
    "source_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "const": "FondosDB"
        },
        "source_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "generated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "report_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "universal_export_present": {
          "type": "boolean"
        },
        "firestore_preview_only": {
          "type": "boolean"
        }
      }
    },
    "retrocession": {
      "type": [
        "number",
        "null"
      ],
      "description": "Heredado de la interfaz Asset base; en la practica la retrocesion vive en costs.retrocession."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "product": {
            "properties": { "has_listing": { "const": true } },
            "required": ["has_listing"]
          }
        },
        "required": ["product"]
      },
      "then": { "required": ["listings"] }
    }
  ],
  "$defs": {
    "listing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listing_id",
        "ticker",
        "currency"
      ],
      "properties": {
        "listing_id": {
          "type": "string"
        },
        "ticker": {
          "type": "string"
        },
        "exchange": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "eodhd_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_listing_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "figi": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_primary": {
          "type": "boolean"
        },
        "data_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
