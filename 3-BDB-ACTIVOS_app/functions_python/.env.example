# Copiar a .env.<projectId>. El destino queda ignorado por Git.
# No incluir claves API: GEMINI se lee desde Secret Manager.
# Valores de diseño: una instalación nueva nace con App Check en observación. Pasarlo a
# enforce es decisión explícita. Las Functions se despliegan con scripts/desplegarFunciones.mjs.
#
# Los gates de escritura de la maestra (BDB_ACTIVOS_ENABLE_MASTER_WRITES y los
# PRICES_/METRICS_/SEARCH_INDEX_/INTEGRITY_WRITE_ENABLED) y los topes del refresco
# (METRICS_REFRESH_*, PRICE_REFRESH_MAX_READS) se fueron el 21-11-2026 con los escritores de
# la base vieja que los leían (censo CENSO_BASE_VIEJA_2026-11-21.md, decisión 31).

BDB_APPCHECK_ENFORCE=false

# ISIN liberados tras una reparación de precios completa y verificada (lista separada
# por comas, sacada del manifiesto de la reparación). Vacío por defecto: solo libera la
# lista estática de incidentes; las retenciones por documento siguen vigentes.
BDB_VERIFIED_PRICE_REPAIR_RELEASES=

# El rol admin se decide solo por el custom claim `admin` (lo pone `npm run nube:administrador`
# de la plataforma); la allowlist ADMIN_UIDS se retiro en S-08 (auditoria 29-09).
#
# Las cuentas de servicio no se declaran: main.py las deriva del proyecto donde corren
# (bdb-functions-reader@<proyecto> y bdb-functions-writer@<proyecto>). Si se declaran
# BDB_READER_SERVICE_ACCOUNT o BDB_WRITER_SERVICE_ACCOUNT, mandan sobre eso, y main.py no
# arranca si nombran el proyecto de BDB.

# --- Clon Gestor Activos Financieros (29-10-2026) ---
# Las Functions leen la maestra como proyecto CRUZADO, y este id decide con que base
# hablan. No hay valor por defecto: sin esta linea abortan al abrir la maestra, nombrandola
# (master_project.py). Solo valen gestor-activos-local y bdb-gestor-de-activos, y el proyecto
# de BDB se rechaza aunque se declare. Desde el 21-11-2026 las Functions solo saben leer la
# base nueva: con gestor-activos-local paran al abrir la maestra, nombrandolo
# (master_project.exigir_base_nueva). Ese valor se deja aqui a proposito (decision 32): es el
# defecto seguro de un guion lanzado a mano, que falla en vez de tocar la base nueva real.
MASTER_PROJECT_ID=gestor-activos-local
# FIRESTORE_EMULATOR_HOST NO se declara aqui: el emulador de Functions la pone solo, y este
# fichero tambien se lee al desplegar, donde dejaria a las funciones buscando un emulador
# (`desplegarFunciones.mjs` se niega a desplegar si la encuentra). Un script a mano que necesite
# el emulador la pone en su entorno: FIRESTORE_EMULATOR_HOST=127.0.0.1:8092.
#
# Los nombres con prefijo FIREBASE_, GCLOUD_ y GOOGLE_ estan RESERVADOS: si
# aparecen en este fichero la CLI de Firebase rechaza el .env entero.
