# Copiar a .env.<projectId>. El destino queda ignorado por Git.
# No incluir claves API: EODHD, FINNHUB y GEMINI se leen desde Secret Manager.
# Valores de diseño: una instalación nueva nace con los gates de escritura cerrados.
# Abrirlos (y pasar App Check de observación a enforce) es decisión explícita. Las
# Functions se despliegan con scripts/desplegarFunciones.mjs.

BDB_APPCHECK_ENFORCE=false
# Gate maestro: solo abre con la frase YES_I_UNDERSTAND_MASTER_DB_WRITES. Cada job
# exige además su gate propio (los *_WRITE_ENABLED de abajo).
BDB_ACTIVOS_ENABLE_MASTER_WRITES=
PRICES_WRITE_ENABLED=false
METRICS_WRITE_ENABLED=false
SEARCH_INDEX_WRITE_ENABLED=false
# Semáforo de integridad (scheduled_integrity_check escribe meta/integrity_status).
INTEGRITY_WRITE_ENABLED=false

# ISIN liberados tras una reparación de precios completa y verificada (lista separada
# por comas, sacada del manifiesto de la reparación). Vacío por defecto: solo libera la
# lista estática de incidentes; las retenciones por documento siguen vigentes.
BDB_VERIFIED_PRICE_REPAIR_RELEASES=

METRICS_REFRESH_BATCH_SIZE=800
# Tope POR EJECUCION. Desde el recalculo de ventanas (13-10-2026) cada activo de
# calculo propio lee su serie entera (~22.000 lecturas toda la poblacion): el
# ciclo se reparte en varias ejecuciones con el cursor de meta/metrics_refresh.
METRICS_REFRESH_MAX_READS=6000
# PRICE_REFRESH_MAX_READS no se define en el entorno desplegado: el código usa 3600
# lecturas por ejecución. Definirla solo para cambiar ese tope.

# El rol admin se decide solo por el custom claim `admin` (scripts/set_admin.py);
# la allowlist ADMIN_UIDS se retiro en S-08 (auditoria 29-09).
#
# Las cuentas de servicio no se declaran: main.py las deriva del proyecto donde corren
# (bdb-functions-reader@<proyecto> y bdb-functions-writer@<proyecto>). Si se declaran
# BDB_READER_SERVICE_ACCOUNT o BDB_WRITER_SERVICE_ACCOUNT, mandan sobre eso, y main.py no
# arranca si nombran el proyecto de BDB.

# --- Clon Gestor Activos Financieros (29-10-2026) ---
# Las Functions leen la maestra como proyecto CRUZADO, y este id decide con que base
# hablan. No hay valor por defecto: sin esta linea abortan al abrir la maestra, nombrandola
# (master_project.py). Solo valen gestor-activos-local y bdb-gestor-de-activos, y el proyecto
# de BDB se rechaza aunque se declare.
MASTER_PROJECT_ID=gestor-activos-local
# Donde esta esa base de datos. Sin esta linea el Buscador sale vacio sin
# decir por que: el codigo se traga la excepcion y cae a un barrido vacio.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8082
#
# Los nombres con prefijo FIREBASE_, GCLOUD_ y GOOGLE_ estan RESERVADOS: si
# aparecen en este fichero la CLI de Firebase rechaza el .env entero.
