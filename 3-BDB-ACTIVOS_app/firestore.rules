// Reglas versionadas de la base de siempre, la del emulador. Las de la web son las de 4-base-nueva.
// A partir de F2-E, cualquier cambio de reglas debe pasar por repo + revisión.
// La BBDD maestra assets/ queda cerrada al cliente; el acceso público va por Cloud
// Functions con Admin SDK. Solo se permite Firestore cliente para carteras app-owned.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isValidIsin(isin) {
      return isin.matches('^[A-Z]{2}[A-Z0-9]{9}[0-9]$');
    }

    function assetExists(isin) {
      return exists(/databases/$(database)/documents/assets/$(isin));
    }

    function isValidCommercialRetro(isin) {
      return isValidIsin(isin)
        && request.resource.data.keys().hasOnly([
          'isin',
          'retro_pct',
          'as_of_date',
          'source',
          'note',
          'status',
          'updated_at',
          'updated_by'
        ])
        && request.resource.data.keys().hasAll([
          'isin',
          'retro_pct',
          'as_of_date',
          'source',
          'updated_at',
          'updated_by'
        ])
        && request.resource.data.isin == isin
        && (!request.resource.data.keys().hasAny(['status'])
          || request.resource.data.status in ['CONFIRMED', 'PENDING_CONFIRMATION'])
        && request.resource.data.retro_pct is number
        && request.resource.data.retro_pct >= 0
        && request.resource.data.retro_pct <= 100
        && request.resource.data.as_of_date is string
        && request.resource.data.as_of_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        // S-09 (auditoría 29-09): topes de tamaño en los textos libres.
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 200
        && request.resource.data.updated_at == request.time
        && request.resource.data.updated_by is string
        && request.resource.data.updated_by.size() <= 320
        && (!request.resource.data.keys().hasAny(['note'])
          || request.resource.data.note == null
          || (request.resource.data.note is string
            && request.resource.data.note.size() <= 2000));
    }

    // --- Herramienta de Análisis y Valoración de Empresas (av_*) ---
    // S-08 (auditoría 29-09): antes una lista de correos en claro; ahora el
    // mismo claim `admin` que el resto de la app, con correo verificado.
    function esAdminVerificado() {
      return isAdmin() && request.auth.token.email_verified == true;
    }

    match /av_watchlist/{docId} {
      allow read, write: if esAdminVerificado();
    }

    match /av_informes/{docId} {
      allow read, write: if esAdminVerificado();
    }

    // La caché la escriben solo las Cloud Functions (Admin SDK, ignora reglas).
    // El cliente no necesita leerla directamente.
    match /av_cache/{docId} {
      allow read, write: if false;
    }

    // Las carteras app-owned se gestionan exclusivamente mediante callable
    // functions, que validan el payload y aislan por UID con Admin SDK.
    match /bdb_activos/{uid}/portfolios/{portfolioId} {
      allow read, write: if false;
    }

    // Retrocesiones comerciales editables: dato app-owned de la aplicacion,
    // separado de la maestra assets/. Ola A1 (Q2): margenes comerciales sensibles;
    // con el registro abierto, la lectura queda reservada al claim admin (antes
    // bastaba iniciar sesion). Una cuenta sin claim vera N/D en las columnas RETRO.
    match /commercial_retro/{isin} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && assetExists(isin) && isValidCommercialRetro(isin);
      allow delete: if isAdmin() && isValidIsin(isin);
    }

    // Foto de cada importacion masiva de retrocesiones (lo que habia y lo que
    // se escribio) para poder deshacerla. Solo admin; nunca se borra.
    // S-09 (auditoría 29-09): la foto nace en `partial` y solo avanza
    // partial -> applied/undone o applied -> undone (undo del cliente); un
    // registro `undone` es inmutable. Reproduce el ciclo de commercialRetroStore.ts.
    function isValidImportReceipt(importId) {
      return request.resource.data.import_id == importId
        && request.resource.data.keys().hasAll(['import_id', 'created_by', 'status', 'previous', 'applied'])
        && request.resource.data.status in ['applied', 'partial', 'undone'];
    }

    function isValidImportTransition() {
      return resource.data.status == 'partial'
        || (resource.data.status == 'applied'
          && request.resource.data.status in ['applied', 'undone']);
    }

    // Firma de la sesión: el cliente guarda `user.email ?? user.uid`.
    function signedBySession(value) {
      return value == request.auth.uid
        || ('email' in request.auth.token && value == request.auth.token.email);
    }

    // ALTA-06 (auditoría 16-10-2026): la foto nace solo con las claves que escribe
    // applyCommercialRetroImport, firmada por quien la crea (el cliente guarda
    // `user.email ?? user.uid`) y con la hora del servidor.
    function isValidImportCreation() {
      return request.resource.data.keys().hasOnly([
          'import_id',
          'created_at',
          'created_by',
          'as_of_date',
          'file_name',
          'scale',
          'replace_all',
          'counts',
          'previous',
          'applied',
          'schema_version',
          'applied_isins',
          'undone_isins',
          'applied_versions',
          'status'
        ])
        && request.resource.data.created_at == request.time
        && signedBySession(request.resource.data.created_by);
    }

    // ALTA-06: después solo cambian los campos del avance por lotes (applied_*,
    // status, error) y del deshacer (undone_*). `previous`, `applied`, `created_*`
    // e `import_id` quedan inmutables: son lo que permite deshacer.
    // Segunda pasada (17-10-2026): con la foto ya en `applied` tampoco cambian
    // `applied_isins`, `applied_versions` ni `applied_batches` (el deshacer compara
    // la revisión con `applied_versions`); solo el deshacer y la anotación de error.
    function isValidImportUpdateKeys() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'applied_isins',
          'applied_versions',
          'applied_batches',
          'status',
          'error',
          'undone_isins',
          'undone_at',
          'undone_by'
        ])
        && (resource.data.status != 'applied'
          || changed.hasOnly(['status', 'error', 'undone_isins', 'undone_at', 'undone_by']));
    }

    // Segunda pasada (17-10-2026): el deshacer queda firmado por la sesión y con la hora
    // del servidor, como la creación. Tercera pasada: cerrar en `undone` exige la hora de
    // este cierre y la firma (el cliente escribe status, undone_at y undone_by juntos);
    // antes bastaba `status: 'undone'` y la foto quedaba cerrada para siempre sin firma.
    function isValidImportUndoStamp() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['undone_by']) || signedBySession(request.resource.data.undone_by))
        && (!changed.hasAny(['undone_at']) || request.resource.data.undone_at == request.time)
        && (request.resource.data.status != 'undone'
          || (changed.hasAll(['undone_at'])
            && request.resource.data.keys().hasAll(['undone_by'])
            && signedBySession(request.resource.data.undone_by)));
    }

    match /commercial_retro_imports/{importId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && isValidImportReceipt(importId)
        && isValidImportCreation()
        && request.resource.data.status == 'partial';
      allow update: if isAdmin()
        && isValidImportReceipt(importId)
        && isValidImportUpdateKeys()
        && isValidImportUndoStamp()
        && isValidImportTransition();
      allow delete: if false;
    }

    // 'assets' (BD maestra) y el resto: NO se gestionan aqui (esta app no impone reglas
    // sobre la BD compartida). Acceso a activos = via Cloud Functions (admin SDK).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
