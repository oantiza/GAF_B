# Config web de Firebase (consola -> Configuracion del proyecto -> Tus apps -> Web).
# Copia este fichero a .env.local y rellena los valores del proyecto autorizado.
# Sin estos valores, la app funciona en modo LOCAL (sin backend ni login).
# Nunca versionar .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check (activar primero en MONITOR en consola Firebase).
# Kill-switch cliente: VITE_FIREBASE_APPCHECK_DISABLED=true
# Provider: enterprise (reCAPTCHA Enterprise) o recaptcha-v3.
VITE_FIREBASE_APPCHECK_PROVIDER=enterprise
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_APPCHECK_DISABLED=false
# Solo desarrollo local autorizado. No versionar tokens reales.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Runtime BDB-ACTIVOS
# Fuentes validas: LOCAL_MOCK, BBDD_STATIC_EXPORT_SAMPLE, BBDD_LIVE_API.
VITE_BDB_DEFAULT_SOURCE=BBDD_STATIC_EXPORT_SAMPLE

# La frontera historica real queda apagada por defecto. Activar solo con backend autorizado.
VITE_BDB_ENABLE_REAL_FRONTIER=false

# El rol admin se decide por custom claim `admin` (se pone con `npm run nube:administrador`
# en 2-plataforma-datos) y el
# backend lo re-verifica en cada callable (_require_admin). La antigua allowlist
# VITE_ADMIN_EMAILS se retiro en A3.5: horneaba emails en el bundle publico.

# Correo verificado (MEDIA-07): la puerta de acceso no monta la app a una cuenta
# sin correo verificado, igual que el backend rechaza sus callables. Es el espejo
# del interruptor de emergencia de functions (BDB_REQUIRE_EMAIL_VERIFIED): si se
# apaga alli, apagarlo tambien aqui.
# VITE_BDB_REQUIRE_EMAIL_VERIFIED=true

# --- Clon Gestor Activos Financieros (29-10-2026) ---
# VITE_FIREBASE_PROJECT_ID=gestor-activos-local
# VITE_BDB_DEFAULT_SOURCE=BBDD_STATIC_EXPORT_SAMPLE
# No pongas aqui las credenciales del proyecto de BDB (bbdd-activos-financieros).
# VITE_FIREBASE_USE_EMULATORS=true
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9097
# VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8082
# VITE_FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5005
# VITE_FIREBASE_APPCHECK_DISABLED=true
#
# Las Cloud Functions necesitan ademas, en functions_python/.env:
#   MASTER_PROJECT_ID=gestor-activos-local
#   FIRESTORE_EMULATOR_HOST=127.0.0.1:8082
# Sin la primera abortan al abrir la maestra, nombrandola; sin la segunda no leen nada.

# ── La BASE NUEVA, proyecto bdb-gestor-de-activos ───────────────────────────────────────
# Configuracion web del proyecto propio, la que lee la base nueva. Se saca de la consola de
# Firebase: Configuracion del proyecto -> Tus apps -> app web.
#
# Van en sus PROPIAS variables y no en VITE_FIREBASE_*, que son las del proyecto que usa el
# resto de la aplicacion. Comprueba que el projectId dice `bdb-gestor-de-activos`: si dice
# `bbdd-activos-financieros` es el de BDB, y la aplicacion se niega a arrancar con el.
VITE_BASE_NUEVA_API_KEY=
VITE_BASE_NUEVA_AUTH_DOMAIN=
VITE_BASE_NUEVA_PROJECT_ID=
VITE_BASE_NUEVA_STORAGE_BUCKET=
VITE_BASE_NUEVA_MESSAGING_SENDER_ID=
VITE_BASE_NUEVA_APP_ID=
