{
  "displayName": "BDB Functions - memoria alta",
  "combiner": "OR",
  "enabled": true,
  "conditions": [
    {
      "displayName": "Utilización de memoria superior al 85%",
      "conditionThreshold": {
        "filter": "resource.type=\"cloud_run_revision\" AND metric.type=\"run.googleapis.com/container/memory/utilizations\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_PERCENTILE_99",
            "crossSeriesReducer": "REDUCE_MAX",
            "groupByFields": ["resource.label.\"service_name\""]
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0.85,
        "duration": "300s",
        "trigger": { "count": 1 }
      }
    }
  ],
  "notificationChannels": [
    "projects/bbdd-activos-financieros/notificationChannels/5488170903588245411"
  ],
  "alertStrategy": {
    "autoClose": "86400s"
  },
  "documentation": {
    "mimeType": "text/markdown",
    "content": "Una Function BDB ha superado el 85% de memoria durante cinco minutos. Revisar servicio, revisión, concurrencia, tamaño de payload y trazas de OOM antes de aumentar recursos."
  }
}
