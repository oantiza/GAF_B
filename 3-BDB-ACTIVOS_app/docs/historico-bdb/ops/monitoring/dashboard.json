{
  "displayName": "BDB - Operación y salud",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 12,
        "height": 2,
        "widget": {
          "title": "Objetivo operativo",
          "text": {
            "format": "MARKDOWN",
            "content": "**SLO interno:** 99,5% de solicitudes sin respuesta 5xx en ventanas de 30 días. Los schedulers deben completar su ciclo sin errores de datos; los cortes por presupuesto sólo son válidos cuando persiste cursor y la siguiente ejecución completa el ciclo."
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 2,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Respuestas 5xx",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "resource.type=\"cloud_run_revision\" AND metric.type=\"run.googleapis.com/request_count\" AND metric.label.\"response_code_class\"=\"5xx\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_SUM",
                      "crossSeriesReducer": "REDUCE_SUM"
                    }
                  }
                }
              }
            ],
            "yAxis": { "label": "peticiones / 5 min", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 2,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Utilización de memoria p99",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "resource.type=\"cloud_run_revision\" AND metric.type=\"run.googleapis.com/container/memory/utilizations\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_PERCENTILE_99",
                      "crossSeriesReducer": "REDUCE_MAX",
                      "groupByFields": ["resource.label.\"service_name\""]
                    }
                  }
                }
              }
            ],
            "yAxis": { "label": "fracción", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 6,
        "width": 12,
        "height": 4,
        "widget": {
          "title": "Instancias activas por servicio",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "STACKED_AREA",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "resource.type=\"cloud_run_revision\" AND metric.type=\"run.googleapis.com/container/instance_count\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_MEAN",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": ["resource.label.\"service_name\""]
                    }
                  }
                }
              }
            ],
            "yAxis": { "label": "instancias", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 10,
        "width": 12,
        "height": 4,
        "widget": {
          "title": "App Check: solicitudes por validez y servicio",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "resource.type=\"firebaseappcheck.googleapis.com/Service\" AND metric.type=\"firebaseappcheck.googleapis.com/services/verification_count\"",
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "perSeriesAligner": "ALIGN_SUM",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "resource.label.\"service_id\"",
                        "metric.label.\"security\""
                      ]
                    }
                  }
                }
              }
            ],
            "yAxis": { "label": "solicitudes / hora", "scale": "LINEAR" }
          }
        }
      }
    ]
  }
}
