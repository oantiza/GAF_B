// Reglas del proyecto nuevo, bdb-gestor-de-activos.
//
// ───────────────────────────────────────────────────────────────────────────────────────
// LO PRIMERO, PORQUE CAMBIA COMO SE LEE TODO LO DEMAS
//
// La base nueva la escribe el Admin SDK desde `2-plataforma-datos`, y el Admin SDK NO pasa
// por estas reglas: las salta por diseño. Así que aquí **nada concede escritura a nadie**, y
// no es un olvido: es que ningún cliente debe escribir en la base. Si algún día la
// aplicación tiene que guardar algo esa regla se abre nombrada, para esa colección y para su
// dueño, y no antes. Hoy solo hay una: las retrocesiones, para el administrador.
//
// Hasta el 02-11-2026 esto era `allow read, write: if false` para todo, con este argumento
// escrito: «un allow read provisional sería invisible hasta el día en que un cliente se
// conecte, que es el peor día para descubrirlo». El argumento sigue valiendo; lo que cambia
// es que ya existe el frontend que lee, y cada cosa que lee tiene aquí su regla.
//
// Medido el 02-11-2026 sobre el código de `src/adapters/baseNuevaLectura.ts`: son cuatro
// lecturas y ninguna escribe. Desde el 03-11-2026 hay además un segundo adaptador,
// `src/adapters/commercialRetroStore.ts`, con su bloque más abajo.
//
//   1. la ficha          -> `instruments/{isin}` y sus subcolecciones, documento a documento
//   2. el buscador       -> consulta de grupo sobre `read` (las tarjetas)
//   3. la salud          -> consulta de grupo sobre `quality`
//   4. las carteras      -> `portfolios` y sus objetivos, por su ruta (sin consulta de grupo desde A-207)
//
// Desde el 13-11-2026 hay una quinta, del Gestor de carteras (`src/gestor/mercado/plataforma.ts`):
//
//   5. el mercado        -> `fx_rates` y `reference_rates`, documento a documento
//
// Y una que todavía no hace y debería: `search_shards`, el índice de búsqueda. Su regla está
// puesta porque el dato ya existe; el día que el buscador lo use no hace falta tocar esto.
// ───────────────────────────────────────────────────────────────────────────────────────
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Quien ha entrado, y con el correo verificado. No basta con tener la app: hace falta
    // sesión, y desde el 16-11-2026 (hallazgo 5 de la auditoría del backend) una sesión con
    // `email_verified`.
    //
    // Hasta ese día bastaba la sesión, y era la única puerta: las Functions y la propia app
    // ya exigían el correo verificado, pero con el alta abierta cualquiera que se registrase
    // sin verificarlo leía el catálogo directamente aquí, sin pasar por ellas. Ahora las tres
    // puertas piden lo mismo.
    //
    // Se compara con `== true` a propósito: un token sin el campo no entra, igual que uno que
    // dice `false`. Y no tiene interruptor: si alguna vez se apaga el de las Functions o el de
    // la app (`BDB_REQUIRE_EMAIL_VERIFIED`, `VITE_BDB_REQUIRE_EMAIL_VERIFIED`), esta regla se
    // cambia aquí y se despliega, porque si no deja fuera a quien esos dejan entrar.
    function esAsesor() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // ── El catálogo: lo que describe un instrumento ──────────────────────────────────
    //
    // Lo lee cualquier asesor con sesión, y nadie lo escribe desde el cliente. El catálogo
    // no es de nadie en particular: los 1.077 instrumentos son los mismos para todos, y lo
    // que distingue a un asesor de otro son sus carteras, no su universo.
    //
    // El comodín de abajo cubre las subcolecciones -`declared/*`, `computed/metrics`,
    // `quality/latest`, `read/card`, `holdings_chunks/*`- a propósito: son 14.900 documentos
    // de catálogo y enumerarlos aquí sería una lista que se queda corta el día que el
    // contrato crezca, que es exactamente el defecto que la auditoría ha tenido tres veces
    // hoy.
    match /instruments/{instrumento} {
      allow read: if esAsesor();
      allow write: if false;
      match /{resto=**} {
        allow read: if esAsesor();
        allow write: if false;
      }
    }

    // ── Las CONSULTAS DE GRUPO, que es donde esto se rompía ─────────────────────────────
    //
    // Una regla anidada dentro de `match /instruments/{instrumento}` vale para leer un
    // documento POR SU RUTA, y no vale para una consulta de grupo de colección. Son dos
    // permisos distintos en Firestore, y la consulta de grupo se evalúa contra una regla que
    // empiece por un comodín de ruta.
    //
    // Sin esto, el buscador y la pantalla de salud daban **403** con sesión y funcionaban
    // con `Bearer owner` contra el emulador, que salta las reglas. Es exactamente el defecto
    // que esta cabecera decía temer: invisible hasta el día en que un cliente se conecte.
    // Lo cazó la prueba del 02-11-2026, no la lectura del fichero.
    //
    // El comodín concede sobre CUALQUIER colección que se llame así, a cualquier
    // profundidad, y como las reglas se combinan con O, gana a un `if false` más específico:
    // una `portfolios/x/declared/y` se leería aunque el bloque de carteras diga que no. Por
    // eso hay solo las que el navegador consulta de verdad, nombradas una a una.
    //
    // Hasta el 21-11-2026 había cinco: estas dos y `declared`, `computed` y `holdings_chunks`
    // (P1-10 de la auditoría integral del 20-11). Medido ese día, el navegador solo lanza dos
    // consultas de grupo, sobre `read` y sobre `quality` (`src/adapters/baseNuevaLecturaSdk.ts`);
    // los bloques y los trozos de cartera los lee por su ruta, que cubre el comodín de
    // `instruments`. Las Functions consultan `targets` en grupo, pero con la cuenta de servicio,
    // que no pasa por estas reglas. Las tres sobraban, y abrían esos nombres en las carteras y
    // los clientes. Si el navegador empieza otra consulta de grupo, su regla se añade aquí, con
    // su nombre, y `probar-reglas.mjs` lo pide: sin ella la consulta da 403.
    match /{ruta=**}/read/{tarjeta} {
      allow read: if esAsesor();
      allow write: if false;
    }
    match /{ruta=**}/quality/{calidad} {
      allow read: if esAsesor();
      allow write: if false;
    }
    // Y los objetivos de cartera ya NO tienen regla de grupo (A-207, 21-11-2026, decisión de Óscar).
    // El navegador no lanza esa consulta desde el 04-11 (las carteras le llegan por la Function
    // `list_portfolios`) y las Functions la hacen con la cuenta de servicio, que no pasa por
    // reglas. Los objetivos se leen por su ruta, dentro de `portfolios/{cartera}/targets`, con
    // el `advisor_id` del dueño (bloque de carteras, más abajo, con la medición de por qué).


    // El índice de búsqueda: tres documentos con las 1.077 entradas. Mismo criterio que el
    // catálogo, porque es una proyección suya.
    match /search_shards/{fragmento} {
      allow read: if esAsesor();
      allow write: if false;
    }

    // ── Los tipos de cambio y el tipo sin riesgo: datos de mercado, no de nadie ──────────
    //
    // Aprobado por Óscar el 13-11-2026. Los lee el Gestor de carteras, que calcula en el
    // navegador: `fx_rates/{DIVISA}_{año}` para valorar en euros lo que cotiza en otra divisa,
    // y `reference_rates/ESTR_{año}` para el ratio de Sharpe. Hasta ese día caían en la
    // cláusula final, porque todo lo que los usaba calculaba en el servidor.
    //
    // Son las series que publica el BCE: datos públicos, sin nada de un cliente ni de una
    // cartera. Mismo criterio que el catálogo: los lee cualquier asesor con sesión y no los
    // escribe ningún cliente. Se leen por su ruta, documento a documento, así que no hace
    // falta regla de grupo; y van nombradas las dos, sin comodín, para que una colección
    // nueva de datos de mercado nazca cerrada.
    match /fx_rates/{serie} {
      allow read: if esAsesor();
      allow write: if false;
    }
    match /reference_rates/{serie} {
      allow read: if esAsesor();
      allow write: if false;
    }

    // ── Los planes de pensiones y las EPSV: un catálogo aparte (decisión D-11, 13-11-2026) ──
    //
    // No son instrumentos de cartera y por eso no cuelgan de `instruments`: los lee Jubilación,
    // para ver la ficha de un plan y ponerla junto a la de otro. Mismo criterio que el catálogo:
    // los lee cualquier asesor con sesión y no los escribe ningún cliente. La serie mensual se lee
    // por su ruta, documento a documento, así que no hace falta regla de grupo; va nombrada, y no
    // con un comodín, para que lo que cuelgue mañana de un plan nazca cerrado.
    //
    // Los datos son de Morningstar y no se pueden redistribuir: por eso viven aquí, detrás de la
    // sesión, y no dentro del sitio, cuyos ficheros se descargan sin entrar.
    match /pension_plans/{plan} {
      allow read: if esAsesor();
      allow write: if false;
      match /series/{serie} {
        allow read: if esAsesor();
        allow write: if false;
      }
    }

    // El acumulado de calidad por fecha, cuando exista. Es catálogo agregado.
    match /quality_rollup/{fecha} {
      allow read: if esAsesor();
      allow write: if false;
    }

    // ── Las carteras: esto SÍ es de alguien ─────────────────────────────────────────────
    //
    // Una cartera la lee su asesor y nadie más. El dueño es `advisor_id`, que es el campo que
    // el contrato declara y el que trajeron las 18 carteras re-originadas el 02-11-2026.
    //
    // Ojo con una trampa de Firestore que importa aquí: una regla sobre el documento NO
    // filtra una consulta de grupo sobre su subcolección. `listarCarteras` lee los objetivos
    // con una consulta de grupo sobre `targets`, y esa consulta se evalúa contra la regla de
    // `targets`, que no puede ver el `advisor_id` del padre sin un `get()`. Un `get()` por
    // documento en una consulta de 220 es inviable, y crece con las carteras.
    //
    // La salida de eso fue conceder por `set_by` -el uid de quien puso el peso-, y **era un
    // agujero**: autoría no es propiedad. Si un asesor pone un objetivo en la cartera de
    // otro, lo sigue leyendo aunque no pueda leer la cartera; y el dueño de la cartera no ve
    // los objetivos que no puso él. Medido el 03-11-2026 con una cartera ajena sembrada a
    // propósito: `portfolios/{ajena}` daba **403** y `portfolios/{ajena}/targets/{isin}`
    // daba **200**. Dos respuestas que se contradicen sobre el mismo dato, y en Firestore la
    // que manda es la más permisiva, porque las reglas se combinan con O.
    //
    // Así que el objetivo lleva ahora su propio `advisor_id`, copiado del padre por el
    // escritor. Está duplicado a propósito: es lo único que una regla de grupo puede
    // comprobar sin leer nada más. La igualdad con el padre la impone
    // `src/ingestion/baseNueva/carteras.ts` y la comprueba `audit:base-nueva`, porque una
    // regla que depende de un campo copiado vale lo que valga la copia.
    //
    // Y el acceso ya no depende de `set_by`, que vuelve a ser lo que su nombre dice: quién
    // puso el peso. Los dos hechos existen y son distintos.
    match /portfolios/{cartera} {
      allow read: if esAsesor() && resource.data.advisor_id == request.auth.uid;
      allow write: if false;

      match /targets/{instrumento} {
        allow read: if esAsesor() && resource.data.advisor_id == request.auth.uid;
        allow write: if false;
      }

      // Lo demás de una cartera -posiciones, operaciones, valoraciones, informes- todavía no
      // se escribe. Cuando se escriba, cada una abre su regla con su dueño, y hasta entonces
      // está cerrada: una regla abierta sobre una colección vacía es una puerta que nadie
      // vigila porque nadie la usa.
      match /{otro=**} {
        allow read, write: if false;
      }
    }

    // ── Los clientes: el dato más sensible que habrá aquí ───────────────────────────────
    //
    // Vacía todavía. La regla está escrita porque el contrato declara `advisor_uids`, una
    // LISTA de asesores, y eso es lo que hay que comprobar: un cliente puede tener más de un
    // asesor y ninguno de los dos es dueño exclusivo.
    match /clients/{cliente} {
      allow read: if esAsesor() && request.auth.uid in resource.data.advisor_uids;
      allow write: if false;
      match /{resto=**} {
        allow read, write: if false;
      }
    }

    // ── Las retrocesiones: márgenes comerciales, solo para administradores ────────
    //
    // Es lo único que la aplicación escribe directamente en esta base, porque así lo hacen la
    // pantalla de administración y las importaciones. Las reglas son las de la base de siempre,
    // copiadas sin cambiar su criterio; lo único distinto es que el instrumento se busca en
    // `instruments`. Quien tiene sesión sin el claim `admin` no las lee. Y como se apoya en
    // `esAsesor()`, el administrador también necesita el correo verificado: el claim no lo
    // sustituye (16-11-2026, hallazgo 5).
    function esAdministrador() {
      return esAsesor() && request.auth.token.admin == true;
    }

    function isAdmin() {
      return esAdministrador();
    }

    function isValidIsin(isin) {
      return isin.matches('^[A-Z]{2}[A-Z0-9]{9}[0-9]$');
    }

    function assetExists(isin) {
      return exists(/databases/$(database)/documents/instruments/$(isin));
    }

    // Firma de la sesión: el cliente guarda `user.email ?? user.uid`.
    function signedBySession(value) {
      return value == request.auth.uid
        || ('email' in request.auth.token && value == request.auth.token.email);
    }

    // P1-10 (auditoría integral del 20-11-2026): `updated_by` va firmado por la sesión, como
    // `created_by` y `undone_by` en las fotos de importación. Antes bastaba que fuera un texto,
    // y un administrador podía dejar escrita la autoría de otro.
    function isValidCommercialRetro(isin) {
      return isValidIsin(isin)
        && signedBySession(request.resource.data.updated_by)
        && request.resource.data.keys().hasOnly([
          'isin',
          'retro_pct',
          'as_of_date',
          'source',
          'note',
          'status',
          'updated_at',
          'updated_by'
        ])
        && request.resource.data.keys().hasAll([
          'isin',
          'retro_pct',
          'as_of_date',
          'source',
          'updated_at',
          'updated_by'
        ])
        && request.resource.data.isin == isin
        && (!request.resource.data.keys().hasAny(['status'])
          || request.resource.data.status in ['CONFIRMED', 'PENDING_CONFIRMATION'])
        && request.resource.data.retro_pct is number
        && request.resource.data.retro_pct >= 0
        && request.resource.data.retro_pct <= 100
        && request.resource.data.as_of_date is string
        && request.resource.data.as_of_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        // S-09 (auditoría 29-09): topes de tamaño en los textos libres.
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 200
        && request.resource.data.updated_at == request.time
        && request.resource.data.updated_by is string
        && request.resource.data.updated_by.size() <= 320
        && (!request.resource.data.keys().hasAny(['note'])
          || request.resource.data.note == null
          || (request.resource.data.note is string
            && request.resource.data.note.size() <= 2000));
    }

    // Retrocesiones comerciales editables: dato app-owned de la aplicacion,
    // separado de la maestra assets/. Ola A1 (Q2): margenes comerciales sensibles;
    // con el registro abierto, la lectura queda reservada al claim admin (antes
    // bastaba iniciar sesion). Una cuenta sin claim vera N/D en las columnas RETRO.
    match /commercial_retro/{isin} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && assetExists(isin) && isValidCommercialRetro(isin);
      allow delete: if isAdmin() && isValidIsin(isin);
    }

    // Foto de cada importacion masiva de retrocesiones (lo que habia y lo que
    // se escribio) para poder deshacerla. Solo admin; nunca se borra.
    // S-09 (auditoría 29-09): la foto nace en `partial` y solo avanza
    // partial -> applied/undone o applied -> undone (undo del cliente); un
    // registro `undone` es inmutable. Reproduce el ciclo de commercialRetroStore.ts.
    function isValidImportReceipt(importId) {
      return request.resource.data.import_id == importId
        && request.resource.data.keys().hasAll(['import_id', 'created_by', 'status', 'previous', 'applied'])
        && request.resource.data.status in ['applied', 'partial', 'undone'];
    }

    function isValidImportTransition() {
      return resource.data.status == 'partial'
        || (resource.data.status == 'applied'
          && request.resource.data.status in ['applied', 'undone']);
    }

    // P1-10 (auditoría integral del 20-11-2026): el tipo y el tope de cada campo de la foto, al
    // crearla y en cada cambio. Hasta entonces se validaban las claves, no lo que llevaban. Los
    // topes salen de lo que escribe `commercialRetroStore.ts`:
    //  - `previous` y `applied` son mapas con las MISMAS claves, una por fila de la importación,
    //    y como mucho 5.000 (el catálogo tiene 1.334 instrumentos, y una retrocesión solo se
    //    escribe sobre uno que exista); `applied_isins`, `undone_isins`, `applied_versions` y
    //    `applied_batches` no pasan de ese número de filas.
    //  - `file_name` es el nombre de un fichero (255, el tope de los sistemas de ficheros);
    //    `error` es un mensaje, que el cliente corta a 2.000, como una nota.
    //  - `counts` lleva solo las cinco acciones de la vista previa.
    // Lo que no se puede mirar aquí es cada valor de los mapas: el documento entero lo acota
    // Firestore en 1 MiB.
    function isValidImportShape() {
      let d = request.resource.data;
      return d.import_id is string && d.import_id.size() <= 100
        && d.created_by is string && d.created_by.size() <= 320
        && (!d.keys().hasAny(['as_of_date'])
          || (d.as_of_date is string && d.as_of_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!d.keys().hasAny(['file_name']) || d.file_name == null
          || (d.file_name is string && d.file_name.size() <= 255))
        && (!d.keys().hasAny(['scale']) || d.scale in ['porcentaje', 'fraccion'])
        && (!d.keys().hasAny(['replace_all']) || d.replace_all is bool)
        && (!d.keys().hasAny(['counts'])
          || (d.counts is map
            && d.counts.keys().hasOnly(['CREATE', 'UPDATE', 'UNCHANGED', 'DELETE', 'OUT_OF_MASTER'])))
        && d.previous is map
        && d.applied is map
        && d.previous.size() <= 5000
        && d.applied.size() == d.previous.size()
        && d.applied.keys().hasOnly(d.previous.keys())
        && (!d.keys().hasAny(['schema_version']) || d.schema_version == 2)
        && (!d.keys().hasAny(['applied_isins'])
          || (d.applied_isins is list && d.applied_isins.size() <= d.applied.size()))
        && (!d.keys().hasAny(['undone_isins'])
          || (d.undone_isins is list && d.undone_isins.size() <= d.applied.size()))
        && (!d.keys().hasAny(['applied_versions'])
          || (d.applied_versions is map && d.applied_versions.size() <= d.applied.size()))
        && (!d.keys().hasAny(['applied_batches'])
          || (d.applied_batches is int && d.applied_batches >= 0 && d.applied_batches <= d.applied.size()))
        && (!d.keys().hasAny(['error']) || (d.error is string && d.error.size() <= 2000))
        && (!d.keys().hasAny(['undone_by']) || (d.undone_by is string && d.undone_by.size() <= 320));
    }

    // ALTA-06 (auditoría 16-10-2026): la foto nace solo con las claves que escribe
    // applyCommercialRetroImport, firmada por quien la crea (el cliente guarda
    // `user.email ?? user.uid`) y con la hora del servidor.
    function isValidImportCreation() {
      return request.resource.data.keys().hasOnly([
          'import_id',
          'created_at',
          'created_by',
          'as_of_date',
          'file_name',
          'scale',
          'replace_all',
          'counts',
          'previous',
          'applied',
          'schema_version',
          'applied_isins',
          'undone_isins',
          'applied_versions',
          'status'
        ])
        && request.resource.data.created_at == request.time
        && signedBySession(request.resource.data.created_by);
    }

    // ALTA-06: después solo cambian los campos del avance por lotes (applied_*,
    // status, error) y del deshacer (undone_*). `previous`, `applied`, `created_*`
    // e `import_id` quedan inmutables: son lo que permite deshacer.
    // Segunda pasada (17-10-2026): con la foto ya en `applied` tampoco cambian
    // `applied_isins`, `applied_versions` ni `applied_batches` (el deshacer compara
    // la revisión con `applied_versions`); solo el deshacer y la anotación de error.
    function isValidImportUpdateKeys() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'applied_isins',
          'applied_versions',
          'applied_batches',
          'status',
          'error',
          'undone_isins',
          'undone_at',
          'undone_by'
        ])
        && (resource.data.status != 'applied'
          || changed.hasOnly(['status', 'error', 'undone_isins', 'undone_at', 'undone_by']));
    }

    // Segunda pasada (17-10-2026): el deshacer queda firmado por la sesión y con la hora
    // del servidor, como la creación. Tercera pasada: cerrar en `undone` exige la hora de
    // este cierre y la firma (el cliente escribe status, undone_at y undone_by juntos);
    // antes bastaba `status: 'undone'` y la foto quedaba cerrada para siempre sin firma.
    function isValidImportUndoStamp() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['undone_by']) || signedBySession(request.resource.data.undone_by))
        && (!changed.hasAny(['undone_at']) || request.resource.data.undone_at == request.time)
        && (request.resource.data.status != 'undone'
          || (changed.hasAll(['undone_at'])
            && request.resource.data.keys().hasAll(['undone_by'])
            && signedBySession(request.resource.data.undone_by)));
    }

    match /commercial_retro_imports/{importId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && isValidImportReceipt(importId)
        && isValidImportCreation()
        && isValidImportShape()
        && request.resource.data.status == 'partial';
      allow update: if isAdmin()
        && isValidImportReceipt(importId)
        && isValidImportShape()
        && isValidImportUpdateKeys()
        && isValidImportUndoStamp()
        && isValidImportTransition();
      allow delete: if false;
    }

    // ── Y todo lo demás, cerrado ────────────────────────────────────────────────────────
    //
    // Emisores, diccionarios de custodio, alias y lo que venga: existen en el contrato y no
    // se leen todavía. El día que se lean, su regla se escribe aquí con su nombre. Esta
    // última cláusula es la que hace que olvidarse signifique «no se puede», y no «se puede
    // todo».
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
